{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Manager",
    "description": "REST API for Task Manager",
    "version": "0.0.1"
  },
  "paths": {
    "/task": {
      "get": {
        "summary": "Получить все задачи",
        "operationId": "TaskList",
        "responses": {
          "200": {
            "description": "Данные получены",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Task"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "Tasks"
        ]
      },
      "post": {
        "summary": "Создать задачу",
        "operationId": "CreateTask",
        "requestBody": {
          "description": "Тело запроса для создания задачи",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_title": {
                    "type": "string"
                  },
                  "task_description": {
                    "type": "string",
                    "nullable": true
                  },
                  "desk_uuid": {
                    "type": "string",
                    "format":"uuid"
                  }
                },
                "required": [
                  "task_title",
                  "desk_uuid"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Задача создана",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Task"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "Tasks"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "models": {},
      "responses": {},
      "Desk": {
        "type": "object",
        "properties": {
          "desk_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "desk_title": {
            "type": "string"
          }
        },
        "required": [
          "desk_uuid", "desk_title"
        ],
        "example": {
          "desk_uuid": "2bc278c0-4dd6-11ef-9483-fd1583719fa0",
          "desk_title": "Test desk"
        }
      }
    }
  }
}